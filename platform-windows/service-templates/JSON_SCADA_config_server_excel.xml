<service>
  <!-- WARNING! This service has no security access control, use with care. -->
  <!-- JS_CSEXCEL_IP_BIND=127.0.0.1 enables just local access. -->
  <id>JSON_SCADA_config_server_excel</id>
  <name>JSON_SCADA_config_server_excel</name>
  <description>JSON-SCADA config_server_excel</description>
  <executable>{root}\platform-windows\nodejs-runtime\node.exe</executable>
  <arguments>"{root}\src\config_server_for_excel\index.js"</arguments>
  <workingdirectory>{root}\src\config_server_for_excel</workingdirectory>
  <env name="JS_CSEXCEL_IP_BIND" value="0.0.0.0"/>
  <env name="JS_CSEXCEL_HTTP_PORT" value="10001"/>
  <startmode>Manual</startmode>
  <logpath>{root}\log</logpath>
  <logname>config_server_excel</logname>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>1</keepFiles>
  </log>
  <onfailure action="restart" delay="2 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>15 sec</stoptimeout>
  <stopparentprocessfirst>true</stopparentprocessfirst>
</service>

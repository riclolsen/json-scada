<service>
  <!-- JS_MCPJSDB_ADMIN_USERNAME / JS_MCPJSDB_ADMIN_PASSWORD enable the admin tools; use a dedicated AdminUI user. -->
  <id>JSON_SCADA_mcp_server</id>
  <name>JSON_SCADA_mcp_server</name>
  <description>JSON-SCADA mcp_server</description>
  <executable>{root}\platform-windows\nodejs-runtime\node.exe</executable>
  <arguments>"{root}\src\mcp-json-scada-db\dist\mcp-server.js" 1 1 "{root}\conf\json-scada.json"</arguments>
  <workingdirectory>{root}\src\mcp-json-scada-db</workingdirectory>
  <env name="JS_MCPJSDB_TRANSPORT" value="http"/>
  <env name="JS_MCPJSDB_IP_BIND" value="127.0.0.1"/>
  <env name="JS_MCPJSDB_HTTP_PORT" value="6001"/>
  <env name="JS_MCPJSDB_ADMIN_USERNAME" value="admin"/>
  <env name="JS_MCPJSDB_ADMIN_PASSWORD" value="jsonscada"/>
  <startmode>Manual</startmode>
  <logpath>{root}\log</logpath>
  <logname>mcp_server</logname>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>1</keepFiles>
  </log>
  <onfailure action="restart" delay="2 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>15 sec</stoptimeout>
  <stopparentprocessfirst>true</stopparentprocessfirst>
</service>

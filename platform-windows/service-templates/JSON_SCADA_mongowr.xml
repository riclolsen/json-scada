<service>
  <!-- Receives protocol data updates from another JSON-SCADA instance (one-way via UDP). -->
  <id>JSON_SCADA_mongowr</id>
  <name>JSON_SCADA_mongowr</name>
  <description>JSON-SCADA mongowr</description>
  <executable>{root}\platform-windows\nodejs-runtime\node.exe</executable>
  <arguments>"{root}\src\mongowr\index.js"</arguments>
  <workingdirectory>{root}\src\mongowr</workingdirectory>
  <startmode>Manual</startmode>
  <logpath>{root}\log</logpath>
  <logname>mongowr</logname>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>1</keepFiles>
  </log>
  <onfailure action="restart" delay="2 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>15 sec</stoptimeout>
  <stopparentprocessfirst>true</stopparentprocessfirst>
</service>
